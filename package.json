{
  "name": "aiida-rest-client",
  "version": "0.1.0",
  "description": "TypeScript client for the AiiDA REST API.",
  "homepage": "https://github.com/aiidateam/aiida-rest-client",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aiidateam/aiida-rest-client.git"
  },
  "bugs": {
    "url": "https://github.com/aiidateam/aiida-rest-client/issues"
  },
  "license": "MIT",
  "keywords": [
    "aiida",
    "rest",
    "api",
    "typescript"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "prepare": "npm run build",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "~6.0.2",
    "vitest": "^4.1.10"
  }
}
